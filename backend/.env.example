PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartdine

# Auth � JWT Secret (production: random 64-char string)
JWT_SECRET=smartdine-secret-key

# CORS � production: set to your Vercel domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini AI � nhi?u API key (ph�n c�ch b?i d?u ph?y) �? xoay v?ng khi g?p quota
GEMINI_API_KEYS=your_key1,your_key2,your_key3
GEMINI_FALLBACK_API_KEYS=

# Model d? ph?ng (th? l?n l�?t, ph�n c�ch b?i d?u ph?y)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Gemini Retry
GEMINI_RETRY_MAX=3
GEMINI_RETRY_DELAY_MS=1000
GEMINI_RETRY_BACKOFF=true

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
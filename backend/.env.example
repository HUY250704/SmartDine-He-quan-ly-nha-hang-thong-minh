PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartdine

# Auth - JWT Secret (production: random 64-char string)
JWT_SECRET=smartdine-secret-key

# CORS - production: set to your Vercel domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Groq AI
GROQ_API_KEY=
GROQ_FALLBACK_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RETRY_MAX=3
GROQ_RETRY_DELAY_MS=1000
GROQ_RETRY_BACKOFF=true
# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

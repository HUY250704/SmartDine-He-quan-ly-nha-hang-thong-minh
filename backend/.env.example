PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartdine

# Auth � JWT Secret (production: random 64-char string)
JWT_SECRET=smartdine-secret-key

# CORS � production: set to your Vercel domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret



# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Model fallback — thử lần lượt từ trái sang phải khi gặp quota
# gemini-2.0-flash      : quota cao nhất (free tier ~1500 req/ngày), ưu tiên dùng trước
# gemini-2.5-flash-lite : quota cao, nhẹ hơn
# gemini-2.5-flash      : chất lượng cao nhất, quota thấp hơn
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash-cyber,gemini-omni,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash\n# Gemini Retry Settings\nGEMINI_RETRY_BACKOFF=true\nGEMINI_RETRY_DELAY_MS=1000\nGEMINI_RETRY_MAX=3\n
# SmartDine Frontend - Environment Variables
#
# Copy this file to .env and adjust values as needed.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Backend API base URL
VITE_API_URL=http://localhost:5000

# Socket.IO server URL
VITE_SOCKET_URL=http://localhost:5000

# Stripe publishable key (test key from https://dashboard.stripe.com/test/apikeys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx